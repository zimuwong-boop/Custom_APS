#!/bin/sh
set -eu
project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export PATH="$project_root/.tools/node/bin:$PATH"
export npm_config_cache="$project_root/.tools/npm-cache"
export PLAYWRIGHT_BROWSERS_PATH="$project_root/.tools/playwright"
export NODE_EXTRA_CA_CERTS="$project_root/.tools/cacert.pem"
cd "$project_root/frontend"
exec "$project_root/.tools/node/bin/npm" "$@"
